<ui:FluentWindow x:Class="Sessionwright.HostKeyPrompt"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:Sessionwright"
                 Title="Sessionwright" Width="620" MinHeight="0" SizeToContent="Height" ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel>
        <ui:TitleBar ShowMinimize="False" ShowMaximize="False" />

        <Grid Margin="24,4,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:SymbolIcon Symbol="ShieldKeyhole24" FontSize="32" Margin="0,0,16,0" VerticalAlignment="Top"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{l:L HostKeyAbout}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="KindText" Style="{StaticResource FieldLabel}" />
                <!-- The fingerprint: to compare, and to copy to whoever can confirm it -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox x:Name="FingerprintBox" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12.5"
                                AutomationProperties.Name="{l:L HostKeyFingerprint}" />
                    <ui:Button Grid.Column="1" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Copy24}" Margin="6,0,0,0"
                               Click="Copy_Click" ToolTip="{l:L HostKeyCopy}" AutomationProperties.Name="{l:L HostKeyCopy}" />
                </Grid>
            </StackPanel>
        </Grid>

        <Border Padding="24,12" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="{l:L SshTrustHost}" Appearance="Primary" MinWidth="100" Click="Trust_Click" />
                <!-- Enter does not trust a server: Cancel is the default -->
                <ui:Button Content="{l:L Cancel}" IsCancel="True" IsDefault="True" MinWidth="100" Margin="8,0,0,0" />
            </StackPanel>
        </Border>
    </StackPanel>
</ui:FluentWindow>
