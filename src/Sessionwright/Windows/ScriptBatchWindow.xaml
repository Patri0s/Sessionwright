<ui:FluentWindow x:Class="Sessionwright.ScriptBatchWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:Sessionwright"
                 Width="860" Height="620" MinWidth="560" MinHeight="380"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
                 WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="*" MinHeight="100" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar x:Name="Bar" ShowMaximize="True" />

        <!-- How far the whole run is -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="24,0,24,10">
            <ui:ProgressRing x:Name="Ring" IsIndeterminate="True" Width="18" Height="18" Margin="0,0,10,0" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <!-- One row per machine: its state, its name, how long it took, the first line it wrote -->
        <ListBox x:Name="List" Grid.Row="2" Margin="24,0,24,8" ScrollViewer.CanContentScroll="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionChanged="List_SelectionChanged" AutomationProperties.Name="{l:L ScriptBatchMachines}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,2" AutomationProperties.Name="{Binding Machine}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:ProgressRing IsIndeterminate="True" Width="14" Height="14" HorizontalAlignment="Left">
                            <ui:ProgressRing.Style>
                                <Style TargetType="ui:ProgressRing" BasedOn="{StaticResource {x:Type ui:ProgressRing}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="Running">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:ProgressRing.Style>
                        </ui:ProgressRing>
                        <ui:SymbolIcon FontSize="16" HorizontalAlignment="Left" ToolTip="{Binding StateText}" AutomationProperties.Name="{Binding StateText}">
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Symbol" Value="Clock20" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="Running">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Done">
                                            <Setter Property="Symbol" Value="CheckmarkCircle20" />
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="DoneWithErrors">
                                            <Setter Property="Symbol" Value="Warning20" />
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Failed">
                                            <Setter Property="Symbol" Value="ErrorCircle20" />
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                        <TextBlock Grid.Column="1" Text="{Binding Machine}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock Grid.Column="2" Text="{Binding Time}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontFamily="Consolas" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Everything the picked machine wrote -->
        <TextBox x:Name="OutputBox" Grid.Row="3" Margin="24,0,24,16" Style="{StaticResource CodeBox}" IsReadOnly="True"
                 AutomationProperties.Name="{l:L ScriptOutput}" />

        <Border Grid.Row="4" Padding="24,12" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False">
                <ui:Button x:Name="AgainButton" Content="{l:L ScriptRunAgain}" Icon="{ui:SymbolIcon ArrowClockwise24}" Click="Again_Click" Margin="0,0,8,0" />
                <ui:Button x:Name="CopyButton" Content="{l:L ScriptCopyAll}" Icon="{ui:SymbolIcon Copy24}" Click="Copy_Click" Margin="0,0,8,0" />
                <ui:Button DockPanel.Dock="Right" Content="{l:L Close}" IsCancel="True" MinWidth="100" Click="Close_Click" />
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
