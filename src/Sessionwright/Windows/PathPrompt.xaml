<ui:FluentWindow x:Class="Sessionwright.PathPrompt"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:Sessionwright"
                 Title="Sessionwright" Width="520" MinHeight="0" SizeToContent="Height" ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel>
        <ui:TitleBar ShowMinimize="False" ShowMaximize="False" />

        <Grid Margin="24,4,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="32" Margin="0,0,16,0" VerticalAlignment="Top"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{l:L TermDownloadPath}" Style="{StaticResource FieldLabel}" />
                <ui:TextBox x:Name="PathBox" FontFamily="Cascadia Mono, Consolas" AutomationProperties.Name="{l:L TermDownloadPath}" TextChanged="PathBox_TextChanged" />
                <TextBlock Text="{l:L TermDownloadHint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <Border Padding="24,12" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="OkButton" Content="{l:L TermDownloadButton}" Appearance="Primary" IsDefault="True" IsEnabled="False" MinWidth="100" Click="Ok_Click" />
                <ui:Button Content="{l:L Cancel}" IsCancel="True" MinWidth="100" Margin="8,0,0,0" />
            </StackPanel>
        </Border>
    </StackPanel>
</ui:FluentWindow>
