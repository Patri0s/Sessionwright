<ui:FluentWindow x:Class="Sessionwright.VmPickerWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:Sessionwright"
                 Title="Sessionwright" Width="620" Height="560" MinWidth="460" MinHeight="360"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" PreviewKeyDown="OnPreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar x:Name="Bar" ShowMinimize="False" ShowMaximize="False" />

        <ui:TextBox x:Name="SearchBox" Grid.Row="1" Margin="24,4,24,8" PlaceholderText="{l:L AzureVmSearch}" Icon="{ui:SymbolIcon Search24}"
                    TextChanged="SearchBox_TextChanged" AutomationProperties.Name="{l:L AzureVmSearch}" />

        <Grid l:Motion.Entrance="True" Grid.Row="2" Margin="24,0,24,12">
            <ListBox x:Name="VmList" ScrollViewer.CanContentScroll="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="VmList_MouseDoubleClick"
                     SelectionChanged="VmList_SelectionChanged" AutomationProperties.Name="{l:L AzureVm}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Desktop24" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding ResourceGroup, Mode=OneWay}" /> · <Run Text="{Binding SubscriptionName, Mode=OneWay}" /> · <Run Text="{Binding Account, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding State, Converter={x:Static l:VmPickerWindow.StateText}}" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <!-- Loading, empty, or no account yet -->
            <l:StatusView x:Name="StatusPanel">
                <ui:Button x:Name="AddAccountButton" Content="{l:L AzureAddAccount}" Icon="{ui:SymbolIcon PersonAdd24}" Appearance="Primary"
                           HorizontalAlignment="Center" Margin="0,12,0,0" Visibility="Collapsed" Click="AddAccount_Click" />
            </l:StatusView>
        </Grid>

        <!-- Directories (e.g. where the account is a guest) that need their own sign-in before their VMs show up -->
        <ItemsControl x:Name="SignInList" Grid.Row="3" Margin="24,0,24,12" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="LockClosed24" Margin="0,0,10,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <ui:Button Grid.Column="2" Margin="12,0,0,0" Content="{l:L AzureSignInAgain}" Icon="{ui:SymbolIcon Person24}"
                                       Click="TenantSignIn_Click" Tag="{Binding}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Row="4" Padding="24,12" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <!-- The list shown is the last one while a fresh one loads -->
                    <ui:ProgressRing x:Name="RefreshRing" IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0" Visibility="Collapsed"
                                     ToolTip="{l:L AzureVmRefreshing}" />
                    <TextBlock x:Name="ProblemsText" Style="{StaticResource Caption}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button x:Name="ChooseButton" Content="{l:L AzureVmChoose}" Appearance="Primary" IsDefault="True" IsEnabled="False"
                               Click="Choose_Click" MinWidth="100" Margin="0,0,8,0" />
                    <ui:Button Content="{l:L Cancel}" IsCancel="True" MinWidth="100" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
