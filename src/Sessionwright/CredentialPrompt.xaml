<ui:FluentWindow x:Class="Sessionwright.CredentialPrompt"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:Sessionwright"
                 Width="460" MinHeight="0" SizeToContent="Height" ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel>
        <ui:TitleBar x:Name="Bar" ShowMinimize="False" ShowMaximize="False" />

        <StackPanel Margin="24,0,24,16">
            <TextBlock x:Name="AddressText" Style="{StaticResource Caption}" />

            <TextBlock Text="{l:L Credential}" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="CredentialBox" AutomationProperties.Name="{l:L Credential}" SelectionChanged="CredentialBox_SelectionChanged" />

            <TextBlock Text="{l:L User}" Style="{StaticResource FieldLabel}" />
            <ui:TextBox x:Name="UserBox" AutomationProperties.Name="{l:L User}" PlaceholderText="{l:L UserPlaceholder}" />

            <TextBlock Text="{l:L Domain}" Style="{StaticResource FieldLabel}" />
            <ui:TextBox x:Name="DomainBox" AutomationProperties.Name="{l:L Domain}" PlaceholderText="{l:L Optional}" />

            <TextBlock Text="{l:L Password}" Style="{StaticResource FieldLabel}" />
            <ui:PasswordBox x:Name="PasswordBox" AutomationProperties.Name="{l:L Password}" />

            <CheckBox x:Name="SaveCredentialBox" Margin="0,12,0,0" />
            <CheckBox x:Name="SaveConnectionBox" Content="{l:L SaveConnection}" />
            <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Margin="0,8,0,0" />
        </StackPanel>

        <Border Padding="24,12" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="{l:L Connect}" Appearance="Primary" IsDefault="True" Click="Ok_Click" MinWidth="100" Margin="0,0,8,0"
                           Icon="{ui:SymbolIcon Play24}" />
                <ui:Button Content="{l:L Cancel}" IsCancel="True" MinWidth="100" />
            </StackPanel>
        </Border>
    </StackPanel>
</ui:FluentWindow>
