<ui:FluentWindow x:Class="Sessionwright.WhatsNewWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:Sessionwright"
                 Title="Sessionwright" Width="560" Height="600" MinWidth="420" MinHeight="320"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar x:Name="Bar" ShowMinimize="False" ShowMaximize="False" />
        <!-- Filled in code: a heading per day, a line per change -->
        <ScrollViewer l:Motion.Entrance="True" Grid.Row="1" Padding="24,0,24,16" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Days" />
        </ScrollViewer>
        <Border Grid.Row="2" Padding="24,12" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <ui:Button Content="{l:L Close}" IsCancel="True" IsDefault="True" MinWidth="100" HorizontalAlignment="Right" />
        </Border>
    </Grid>
</ui:FluentWindow>
