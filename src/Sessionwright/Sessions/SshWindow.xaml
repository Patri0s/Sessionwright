<ui:FluentWindow x:Class="Sessionwright.SshWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
                 xmlns:l="clr-namespace:Sessionwright"
                 Icon="pack://application:,,,/Sessionwright;component/Assets/app.ico" Width="1000" Height="640" MinWidth="420" MinHeight="260"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen">
    <!-- One surface, in the terminal's own shade (the session stage's): the title bar and the bars below do not sit on
         another color than the text between them. -->
    <Grid Background="{DynamicResource StageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="Bar">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Sessionwright;component/Assets/app.ico" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                    <!-- Who and where: the account ssh signs in with, at the address -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <ui:SymbolIcon Symbol="WindowConsole20" FontSize="14" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="WhereText" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon ArrowClockwise24}" Click="Reconnect_Click" ToolTip="{l:L Reconnect}" />
                    <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon FullScreenMaximize24}" Click="FullScreen_Click" ToolTip="{l:L SshFullScreenTip}" />
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>
        <!-- Environment color of the connection (or its group), as on a session window -->
        <Border x:Name="EnvStrip" Height="2" VerticalAlignment="Top" IsHitTestVisible="False"
                Background="{Binding Connection.EffectiveColor, Converter={StaticResource HexBrush}}" />

        <!-- The terminal: a web view with xterm.js, which shows what ssh.exe prints (see SshWindow.xaml.cs) -->
        <wv2:WebView2 x:Name="View" Grid.Row="1" DefaultBackgroundColor="Transparent" />
        <!-- In its place until the page is up, and when it cannot be (no WebView2 runtime, no ssh.exe) -->
        <l:StatusView x:Name="Status" Grid.Row="1" Visibility="Collapsed" />

        <!-- ssh has ended: what it said stays readable above, and it can be started again. Below the web view, not over
             it: WPF cannot draw over another window's pixels. -->
        <Border x:Name="EndedBar" Grid.Row="2" Padding="12,8" Visibility="Collapsed"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="EndedText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button x:Name="ReconnectButton" Content="{l:L Reconnect}" Icon="{ui:SymbolIcon ArrowClockwise24}" Appearance="Primary"
                               Click="Reconnect_Click" Margin="0,0,8,0" />
                    <ui:Button Content="{l:L CloseWindow}" Icon="{ui:SymbolIcon Dismiss24}" Click="Close_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- A quiet line of facts: since when, how big the terminal is, how far the server -->
        <Grid x:Name="StatusBar" Grid.Row="3" Margin="14,2,12,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StateText" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <TextBlock x:Name="FactsText" Grid.Column="1" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </Grid>
    </Grid>
</ui:FluentWindow>
