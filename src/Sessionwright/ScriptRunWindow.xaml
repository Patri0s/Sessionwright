<ui:FluentWindow x:Class="Sessionwright.ScriptRunWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:Sessionwright"
                 Width="760" Height="520" MinWidth="460" MinHeight="300"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
                 WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar x:Name="Bar" ShowMaximize="True" />

        <!-- What is going on: running (with the seconds so far), done, failed -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="24,0,24,10">
            <ui:ProgressRing x:Name="Ring" IsIndeterminate="True" Width="18" Height="18" Margin="0,0,10,0" />
            <ui:SymbolIcon x:Name="Glyph" FontSize="18" Margin="0,0,10,0" Visibility="Collapsed" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <!-- What the script wrote: as it is, in a fixed-width font, to select and copy -->
        <TextBox x:Name="OutputBox" Grid.Row="2" Margin="24,0,24,16" Style="{StaticResource CodeBox}" IsReadOnly="True"
                 AutomationProperties.Name="{l:L ScriptOutput}" />

        <Border Grid.Row="3" Padding="24,12" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False">
                <ui:Button x:Name="AgainButton" Content="{l:L ScriptRunAgain}" Icon="{ui:SymbolIcon ArrowClockwise24}" Click="Again_Click" Margin="0,0,8,0" />
                <ui:Button x:Name="CopyButton" Content="{l:L ScriptCopy}" Icon="{ui:SymbolIcon Copy24}" Click="Copy_Click" Margin="0,0,8,0" />
                <!-- The way out of a failure that has one: sign in to Azure again, or add the account -->
                <ui:Button x:Name="FixButton" Appearance="Primary" Click="Fix_Click" Visibility="Collapsed" />
                <ui:Button DockPanel.Dock="Right" Content="{l:L Close}" IsCancel="True" MinWidth="100" Click="Close_Click" />
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
