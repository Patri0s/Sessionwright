<ui:FluentWindow x:Class="Sessionwright.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:Sessionwright"
                 Width="860" Height="620" MinWidth="640" MinHeight="400"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <ui:FluentWindow.Resources>
        <!-- Each section's settings on one card, like Windows 11 Settings -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        </Style>
        <!-- A card's name within a section that has several -->
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,16,0,4" />
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <!-- The sections listed on the left as in Windows 11 Settings: the chosen one on a subtle background with a short
             accent bar at its left edge; one section shown at a time on the right. -->
        <Style x:Key="Nav" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel IsItemsHost="True" Margin="12,0,8,0" KeyboardNavigation.TabIndex="1"
                                        KeyboardNavigation.DirectionalNavigation="Cycle" />
                            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Column="1" ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavItem" TargetType="TabItem">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FocusVisualStyle">
                <Setter.Value>
                    <Style>
                        <Setter Property="Control.Template">
                            <Setter.Value>
                                <ControlTemplate>
                                    <Border Margin="0,1" CornerRadius="5" BorderThickness="2" BorderBrush="{DynamicResource FocusStrokeColorOuterBrush}" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Background="Transparent" Margin="0,1">
                            <Border x:Name="Back" CornerRadius="4" Background="Transparent" />
                            <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Hidden" />
                            <ContentPresenter ContentSource="Header" Margin="14,9,12,9" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Based on the app's own: without it the pages lost its smooth wheel scrolling -->
        <Style x:Key="Page" TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
            <Setter Property="Padding" Value="16,0,24,16" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Focusable" Value="False" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar x:Name="Bar" ShowMinimize="False" ShowMaximize="False" />

        <TabControl FocusVisualStyle="{x:Null}" l:Motion.Entrance="True" x:Name="Tabs" Grid.Row="1" Style="{StaticResource Nav}" ItemContainerStyle="{StaticResource NavItem}"
                    TextBoxBase.TextChanged="Field_Changed" Selector.SelectionChanged="Field_Changed" ButtonBase.Click="Field_Changed">
            <TabItem AutomationProperties.Name="{l:L General}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Options24" Margin="0,0,12,0" />
                        <TextBlock Text="{l:L General}" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Style="{StaticResource Page}">
                    <StackPanel>
                        <TextBlock Text="{l:L General}" Style="{StaticResource PageTitle}" TextWrapping="Wrap" />
                        <TextBlock Text="{l:L Appearance}" Style="{StaticResource CardTitle}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{l:L Language}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <ComboBox x:Name="LanguageBox" AutomationProperties.Name="{l:L Language}" />
                                <TextBlock Text="{l:L Theme}" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="ThemeBox" AutomationProperties.Name="{l:L Theme}" />
                                <CheckBox x:Name="AccentBox" Content="{l:L UseSystemAccent}" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{l:L Behavior}" Style="{StaticResource CardTitle}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="ProbeBox" Content="{l:L ProbeHosts}" />
                                <CheckBox x:Name="SkipConfirmBox" Content="{l:L SkipSessionConfirmations}" Margin="0,8,0,0" />
                                <CheckBox x:Name="CertificateBox" Content="{l:L SkipCertificateWarning}" Margin="0,8,0,0" />
                                <TextBlock Text="{l:L SkipCertificateWarningHint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="28,2,0,0" />
                                <CheckBox x:Name="TrayBox" Content="{l:L RunInTray}" Margin="0,8,0,0" />
                                <TextBlock Text="{l:L RunInTrayHint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="28,2,0,0" />
                                <!-- What an installer wizard would ask; only an installed copy has something to point a shortcut at -->
                                <StackPanel x:Name="ShortcutsPanel">
                                    <CheckBox x:Name="DesktopShortcutBox" Content="{l:L DesktopShortcut}" Margin="0,8,0,0" Click="Shortcut_Click" />
                                    <CheckBox x:Name="StartMenuShortcutBox" Content="{l:L StartMenuShortcut}" Margin="0,8,0,0" Click="Shortcut_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{l:L NavShortcut}" Style="{StaticResource CardTitle}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{l:L QuickConnectKey}" Margin="0,0,0,6" />
                                <StackPanel Orientation="Horizontal">
                                    <ui:TextBox x:Name="HotkeyBox" Width="220" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                                GotKeyboardFocus="HotkeyBox_GotKeyboardFocus" LostKeyboardFocus="HotkeyBox_LostKeyboardFocus"
                                                PlaceholderText="{l:L QuickConnectKeyNone}" AutomationProperties.Name="{l:L QuickConnectKey}" />
                                    <ui:Button Content="{l:L QuickConnectKeyClear}" Margin="8,0,0,0" Click="HotkeyClear_Click" />
                                </StackPanel>
                                <TextBlock x:Name="HotkeyHint" Text="{l:L QuickConnectKeyHint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="RdpTab" AutomationProperties.Name="{l:L NavRdp}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Desktop24" Margin="0,0,12,0" />
                        <TextBlock Text="{l:L NavRdp}" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Style="{StaticResource Page}">
                    <StackPanel>
                        <TextBlock Text="{l:L DefaultRdp}" Style="{StaticResource PageTitle}" TextWrapping="Wrap" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{l:L DefaultRdpHint}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                <l:RdpOptionsView x:Name="Options" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem AutomationProperties.Name="{l:L AzureAccounts}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Cloud24" Margin="0,0,12,0" />
                        <TextBlock Text="{l:L AzureAccounts}" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Style="{StaticResource Page}">
                    <StackPanel>
                        <TextBlock Text="{l:L AzureAccounts}" Style="{StaticResource PageTitle}" TextWrapping="Wrap" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{l:L AzureAccountsHint}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                <ItemsControl x:Name="AzureList" Margin="0,8,0,0" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon Symbol="Person24" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Username}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding TenantText}" Style="{StaticResource Caption}" />
                                                </StackPanel>
                                                <ui:Button Grid.Column="2" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Delete24}"
                                                           Click="RemoveAzureAccount_Click" Tag="{Binding}" ToolTip="{l:L AzureRemoveAccount}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <ui:Button x:Name="AddAzureButton" Content="{l:L AzureAddAccount}" Icon="{ui:SymbolIcon PersonAdd24}" Click="AddAzureAccount_Click" />
                                    <TextBlock x:Name="AzureStatus" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem AutomationProperties.Name="{l:L UpdatesAndData}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowSync24" Margin="0,0,12,0" />
                        <TextBlock Text="{l:L UpdatesAndData}" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Style="{StaticResource Page}">
                    <StackPanel>
                        <TextBlock Text="{l:L UpdatesAndData}" Style="{StaticResource PageTitle}" TextWrapping="Wrap" />
                        <TextBlock Text="{l:L Updates}" Style="{StaticResource CardTitle}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                <ui:HyperlinkButton Content="{l:L WhatsNew}" Click="WhatsNew_Click" Padding="0" Margin="0,2,0,2" />
                                <TextBlock x:Name="FeedHint" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <ui:Button x:Name="CheckButton" Content="{l:L CheckForUpdates}" Icon="{ui:SymbolIcon ArrowSync24}" Click="CheckUpdates_Click" />
                                    <TextBlock x:Name="CheckResult" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{l:L Data}" Style="{StaticResource CardTitle}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="PathText" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                <WrapPanel Margin="0,12,0,0">
                                    <ui:Button Content="{l:L OpenFolder}" Icon="{ui:SymbolIcon Open24}" Click="OpenFolder_Click" Margin="0,0,8,8" />
                                    <ui:Button Content="{l:L OpenLog}" Icon="{ui:SymbolIcon DocumentText24}" Click="OpenLog_Click" Margin="0,0,8,8" />
                                    <ui:Button Content="{l:L ReportProblem}" Icon="{ui:SymbolIcon Bug24}" Click="ReportProblem_Click" Margin="0,0,8,8" />
                                </WrapPanel>
                                <TextBlock Text="{l:L ReportProblemHint}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Padding="24,12" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <!-- Every change applies at once, as in Windows 11 Settings: nothing to save or to cancel -->
                <ui:Button Grid.Column="1" Content="{l:L CloseWindow}" IsCancel="True" MinWidth="100" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
