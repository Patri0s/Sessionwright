<ui:FluentWindow x:Class="Sessionwright.Dialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Sessionwright" Width="460" MinHeight="0" SizeToContent="Height" ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel>
        <ui:TitleBar ShowMinimize="False" ShowMaximize="False" />

        <Grid Margin="24,4,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:SymbolIcon x:Name="Glyph" Filled="True" FontSize="32" Margin="0,0,16,0" VerticalAlignment="Top" />
            <ScrollViewer Grid.Column="1" MaxHeight="480" VerticalScrollBarVisibility="Auto" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="MessageText" FontSize="14" TextWrapping="Wrap" />
                    <!-- What is still being found out (who else uses a machine): a ring and a note, then the answer -->
                    <Grid x:Name="MorePanel" Margin="0,12,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:ProgressRing x:Name="MoreRing" IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Top" />
                        <TextBlock x:Name="MoreText" Grid.Column="1" FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Padding="24,12" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="PrimaryButton" Appearance="Primary" IsDefault="True" MinWidth="100" Click="Primary_Click" />
                <ui:Button x:Name="AlternativeButton" MinWidth="100" Margin="8,0,0,0" Click="Alternative_Click" Visibility="Collapsed" />
                <ui:Button x:Name="SecondaryButton" IsCancel="True" MinWidth="100" Margin="8,0,0,0" />
            </StackPanel>
        </Border>
    </StackPanel>
</ui:FluentWindow>
