<ui:FluentWindow x:Class="Sessionwright.ColorPickerWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:Sessionwright"
                 Title="Sessionwright" Width="340" SizeToContent="Height" ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel>
        <ui:TitleBar x:Name="Bar" ShowMinimize="False" ShowMaximize="False" />

        <StackPanel l:Motion.Entrance="True" Margin="24,0,24,20">
            <!-- Saturation across, brightness down, for the hue below -->
            <Grid x:Name="Field" Height="180" Focusable="True" FocusVisualStyle="{x:Null}" Background="Transparent" Cursor="Cross"
                  MouseLeftButtonDown="Field_MouseDown" MouseMove="Field_MouseMove" MouseLeftButtonUp="Area_MouseUp" KeyDown="Field_KeyDown"
                  GotKeyboardFocus="Area_FocusChanged" LostKeyboardFocus="Area_FocusChanged" SizeChanged="Area_SizeChanged"
                  AutomationProperties.Name="{l:L ColorPickerField}">
                <!-- The colors are cut to the rounded corners; the thumb is not, so it shows whole at an edge -->
                <Grid>
                    <Grid.Clip>
                        <RectangleGeometry x:Name="FieldClip" RadiusX="6" RadiusY="6" />
                    </Grid.Clip>
                    <Rectangle x:Name="HueFill" Fill="Red" />
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="White" Offset="0" />
                                <GradientStop Color="#00FFFFFF" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0" />
                                <GradientStop Color="Black" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>
                <Canvas IsHitTestVisible="False">
                    <Ellipse x:Name="FieldThumb" Width="18" Height="18" Stroke="White" StrokeThickness="2.5" />
                    <Ellipse x:Name="FieldThumbShade" Width="20" Height="20" Stroke="#66000000" StrokeThickness="1" />
                </Canvas>
            </Grid>

            <!-- The hues, round the color circle -->
            <Grid x:Name="HueStrip" Height="16" Margin="0,16,0,0" Focusable="True" FocusVisualStyle="{x:Null}" Background="Transparent"
                  MouseLeftButtonDown="Hue_MouseDown" MouseMove="Hue_MouseMove" MouseLeftButtonUp="Area_MouseUp" KeyDown="Hue_KeyDown"
                  GotKeyboardFocus="Area_FocusChanged" LostKeyboardFocus="Area_FocusChanged" SizeChanged="Area_SizeChanged"
                  AutomationProperties.Name="{l:L ColorPickerHue}">
                <Border CornerRadius="8">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FF0000" Offset="0" />
                            <GradientStop Color="#FFFF00" Offset="0.1667" />
                            <GradientStop Color="#00FF00" Offset="0.3333" />
                            <GradientStop Color="#00FFFF" Offset="0.5" />
                            <GradientStop Color="#0000FF" Offset="0.6667" />
                            <GradientStop Color="#FF00FF" Offset="0.8333" />
                            <GradientStop Color="#FF0000" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Canvas IsHitTestVisible="False">
                    <Ellipse x:Name="HueThumb" Width="20" Height="20" Canvas.Top="-2" Stroke="White" StrokeThickness="2.5" />
                </Canvas>
            </Grid>

            <!-- What it is now, beside the one it was; the code to type or paste -->
            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="64" Height="34" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        VerticalAlignment="Bottom" Margin="0,0,12,0" ClipToBounds="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="OldPreview" CornerRadius="5,0,0,5" ToolTip="{l:L ColorPickerBefore}" />
                        <Border x:Name="NewPreview" Grid.Column="1" CornerRadius="0,5,5,0" ToolTip="{l:L ColorPickerNow}" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{l:L ColorPickerHex}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                    <ui:TextBox x:Name="HexBox" MaxLength="7" TextChanged="HexBox_TextChanged" LostKeyboardFocus="HexBox_LostFocus"
                                AutomationProperties.Name="{l:L ColorPickerHex}" />
                </StackPanel>
            </Grid>

            <!-- Colors picked before, here and in other connections -->
            <StackPanel x:Name="RecentPanel" Margin="0,16,0,0">
                <TextBlock Text="{l:L ColorPickerRecent}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                <WrapPanel x:Name="RecentList" />
            </StackPanel>
        </StackPanel>

        <Border Padding="24,12" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="{l:L ColorPickerChoose}" Appearance="Primary" IsDefault="True" MinWidth="100" Click="Choose_Click" />
                <ui:Button Content="{l:L Cancel}" IsCancel="True" MinWidth="100" Margin="8,0,0,0" />
            </StackPanel>
        </Border>
    </StackPanel>
</ui:FluentWindow>
