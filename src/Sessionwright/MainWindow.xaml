<ui:FluentWindow x:Class="Sessionwright.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:Sessionwright"
                 Title="Sessionwright" Icon="pack://application:,,,/Sessionwright;component/Assets/app.ico" Width="1280" Height="800" MinWidth="760" MinHeight="480"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen"
                 PreviewKeyDown="OnPreviewKeyDown" PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown" Closing="OnClosing">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Phase of an open session: green when ready, amber while connecting / signing in, gray when ended -->
        <Style x:Key="PhaseDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Phase}" Value="Ready">
                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Phase}" Value="Disconnected">
                    <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The full address on hover over a host cut off in the tree; its own ToolTip, as the default one wraps at a fixed
             width and cut the address off -->
        <ToolTip x:Key="AddressTip" x:Shared="False" MaxWidth="900">
            <TextBlock Text="{Binding Address}" TextWrapping="NoWrap" />
        </ToolTip>

        <!-- Address under the name; a connection without a name already shows the address as its title -->
        <Style x:Key="AddressCaption" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Text" Value="{Binding Address}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Name}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Environment color strip; hidden when the node has none -->
        <Style x:Key="EnvStrip" TargetType="Rectangle">
            <Setter Property="Width" Value="3" />
            <Setter Property="RadiusX" Value="1.5" />
            <Setter Property="RadiusY" Value="1.5" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Fill" Value="{Binding EffectiveColor, Converter={StaticResource HexBrush}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding EffectiveColor}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Hidden" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- It has notes: a small mark, the notes on hover (they were only to be read by opening the editor) -->
        <Style x:Key="NotesMark" TargetType="ui:SymbolIcon">
            <Setter Property="Symbol" Value="Note20" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="ToolTip" Value="{Binding Notes}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Notes}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <HierarchicalDataTemplate DataType="{x:Type l:Group}" ItemsSource="{Binding Children}">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Grid.Column="2" Style="{StaticResource NotesMark}" />
                <ui:SymbolIcon Symbol="Folder20" Filled="True" Margin="0,0,8,0">
                    <ui:SymbolIcon.Style>
                        <Style TargetType="ui:SymbolIcon">
                            <Setter Property="Foreground" Value="{Binding EffectiveColor, Converter={StaticResource HexBrush}}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EffectiveColor}" Value="{x:Null}">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:SymbolIcon.Style>
                </ui:SymbolIcon>
                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Grid>
        </HierarchicalDataTemplate>

        <DataTemplate DataType="{x:Type l:Connection}">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Rectangle Style="{StaticResource EnvStrip}" Margin="0,2,6,2" />
                <!-- What it is: a cloud for an Azure machine (its name on hover), a monitor for any other; filled in the accent
                     color while a session of it is open. One icon says it, not another mark next to the status. -->
                <ui:SymbolIcon Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center">
                    <ui:SymbolIcon.Style>
                        <Style TargetType="ui:SymbolIcon">
                            <Setter Property="Symbol" Value="Cloud20" />
                            <Setter Property="ToolTip" Value="{Binding AzureTip}" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding AzureTip}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AzureVm}" Value="{x:Null}">
                                    <Setter Property="Symbol" Value="Desktop20" />
                                    <Setter Property="ToolTip" Value="{x:Null}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                    <Setter Property="Filled" Value="True" />
                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <Setter Property="ToolTip" Value="{l:L SessionOpen}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:SymbolIcon.Style>
                </ui:SymbolIcon>
                <!-- Long host names are cut off: the full address on hover -->
                <StackPanel Grid.Column="2">
                    <!-- The star right after the name (a long name is cut off before it); none in the favorites list itself,
                         where every row is one -->
                    <DockPanel HorizontalAlignment="Left">
                        <ui:SymbolIcon DockPanel.Dock="Right" Symbol="Star20" Filled="True" FontSize="12" Margin="5,0,0,0"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}" VerticalAlignment="Center"
                                       ToolTip="{l:L Favorite}" AutomationProperties.Name="{l:L Favorite}">
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Favorite}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="Favorites">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                        <!-- The title is the host itself when the connection has no name -->
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Name}" Value="">
                                            <Setter Property="ToolTip" Value="{StaticResource AddressTip}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DockPanel>
                    <TextBlock Style="{StaticResource AddressCaption}" TextTrimming="CharacterEllipsis" ToolTip="{StaticResource AddressTip}" />
                </StackPanel>
                <ui:SymbolIcon Grid.Column="3" Style="{StaticResource NotesMark}" />
                <Ellipse Grid.Column="4" Style="{StaticResource OnlineDot}" />
            </Grid>
        </DataTemplate>

        <!-- Command (or quick connect) in the search results -->
        <DataTemplate DataType="{x:Type l:SearchAction}">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Symbol="{Binding Icon}" Margin="0,0,8,0" VerticalAlignment="Center">
                    <ui:SymbolIcon.Style>
                        <Style TargetType="ui:SymbolIcon">
                            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <Style.Triggers>
                                <!-- Shuts down, restarts, signs out or disconnects: in the caution color, one Enter away as it is -->
                                <DataTrigger Binding="{Binding Danger}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:SymbolIcon.Style>
                </ui:SymbolIcon>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Kind}" Style="{StaticResource Caption}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- A connection as a card on the home page (left running, recent) -->
        <ItemsPanelTemplate x:Key="CardPanel">
            <WrapPanel />
        </ItemsPanelTemplate>
        <DataTemplate x:Key="ConnectionCard">
            <ui:Button Width="250" Margin="4" Padding="12,10" HorizontalContentAlignment="Stretch"
                       Click="ConnectButton_Click" Tag="{Binding}" AutomationProperties.Name="{Binding Title}" ToolTip="{l:L CardConnectTip}" PreviewMouseLeftButtonDown="Card_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="Card_PreviewMouseLeftButtonUp">
                <!-- Its own text color: the button darkens its content while pressed, which made the name unreadable -->
                <Grid TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Rectangle Style="{StaticResource EnvStrip}" Margin="0,0,8,0" />
                    <!-- A cloud for an Azure machine, as in the tree -->
                    <ui:SymbolIcon Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Symbol" Value="Cloud24" />
                                <Setter Property="ToolTip" Value="{Binding AzureTip}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AzureVm}" Value="{x:Null}">
                                        <Setter Property="Symbol" Value="Desktop24" />
                                        <Setter Property="ToolTip" Value="{x:Null}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource AddressCaption}" />
                    </StackPanel>
                    <Ellipse Grid.Column="3" Style="{StaticResource OnlineDot}" />
                </Grid>
            </ui:Button>
        </DataTemplate>

        <!-- A row's menu, short: what is done to the connection itself. What concerns the machine behind it (power, who is
             signed in, the auto-shutdown) is one item with a submenu; "New…" and sorting are a group's and the empty
             list's, not a connection's. It had 19 items in a row, the two used most lost among the rare ones. -->
        <ContextMenu x:Key="NodeMenu" x:Shared="False" Opened="NodeMenu_Opened">
            <MenuItem Tag="connect" Header="{l:L Connect}" Click="Menu_Connect" Icon="{ui:SymbolIcon Play24}" FontWeight="SemiBold" InputGestureText="Enter" />
            <MenuItem Tag="conn" Header="{l:L ConnectAs}" Click="Menu_ConnectAs" Icon="{ui:SymbolIcon Person24}" />
            <MenuItem Tag="group" Header="{l:L ConnectAll}" Click="Menu_ConnectAll" Icon="{ui:SymbolIcon Play24}" />
            <MenuItem Tag="links" Header="{l:L OpenLink}" Icon="{ui:SymbolIcon Link24}" />
            <Separator />
            <MenuItem Tag="machine" Header="{l:L MachineMenu}" Icon="{ui:SymbolIcon Server24}">
                <MenuItem Tag="vm" Header="{l:L AzureVmStartMenu}" Click="Menu_StartVm" Icon="{ui:SymbolIcon Play24}" />
                <MenuItem Tag="vmstop" Header="{l:L AzureVmStopMenu}" Click="Menu_StopVm" Icon="{ui:SymbolIcon Power24}" />
                <MenuItem Tag="power" Header="{l:L PowerMenu}" Click="Menu_Power" Icon="{ui:SymbolIcon ArrowReset24}" />
                <MenuItem Tag="vmpostpone" Header="{l:L AzurePostponeMenu}" Click="Menu_PostponeShutdown" Icon="{ui:SymbolIcon Clock24}" />
                <MenuItem Tag="vmskip" Click="Menu_SkipShutdown" Icon="{ui:SymbolIcon CalendarCancel24}" />
                <MenuItem Tag="conn" Header="{l:L SignedInMenu}" Click="Menu_SignedIn" Icon="{ui:SymbolIcon People24}" />
            </MenuItem>
            <MenuItem Tag="scripts" Header="{l:L ScriptsMenu}" Icon="{ui:SymbolIcon Code24}" />
            <Separator />
            <MenuItem Tag="fav" Header="{l:L AddFavorite}" Click="Menu_Favorite" Icon="{ui:SymbolIcon Star24}" />
            <MenuItem Tag="node" Header="{l:L Edit}" Click="Menu_Edit" Icon="{ui:SymbolIcon Edit24}" InputGestureText="F2" />
            <MenuItem Tag="conn" Header="{l:L Duplicate}" Click="Menu_Duplicate" Icon="{ui:SymbolIcon Copy24}" />
            <Separator />
            <MenuItem Tag="new" Header="{l:L NewConnection}" Click="NewConnection_Click" Icon="{ui:SymbolIcon Add24}" InputGestureText="Ctrl+N" />
            <MenuItem Tag="new" Header="{l:L NewGroup}" Click="NewGroup_Click" Icon="{ui:SymbolIcon FolderAdd24}" />
            <MenuItem Tag="sort" Header="{l:L SortByName}" Click="Menu_SortByName" Icon="{ui:SymbolIcon TextSortAscending24}" />
            <Separator />
            <MenuItem Tag="delete" Header="{l:L Delete}" Click="Menu_Delete" Icon="{ui:SymbolIcon Delete24}" InputGestureText="Del" />
        </ContextMenu>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="Bar" Title="Sessionwright" HorizontalContentAlignment="Center">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Sessionwright;component/Assets/app.ico" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.TrailingContent>
                <!-- Sized and placed like the caption buttons next to it -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                    <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Cloud24, FontSize=16}" Click="Machines_Click" ToolTip="{l:L MachinesTip}"
                               Width="44" Height="30" CornerRadius="0" />
                    <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon QuestionCircle24, FontSize=16}" Click="Shortcuts_Click" ToolTip="{l:L ShortcutsTip}"
                               Width="44" Height="30" CornerRadius="0" />
                    <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Settings24, FontSize=16}" Click="Settings_Click" ToolTip="{l:L SettingsTip}"
                               Width="44" Height="30" CornerRadius="0" />
                </StackPanel>
            </ui:TitleBar.TrailingContent>
            <ui:TitleBar.CenterContent>
                <ui:TextBox x:Name="SearchBox" Width="460" Margin="0,4" PlaceholderText="{l:L SearchPlaceholder}"
                            Icon="{ui:SymbolIcon Search24}" ClearButtonEnabled="True" AutomationProperties.Name="{l:L Search}"
                            TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown" />
            </ui:TitleBar.CenterContent>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="320" MinWidth="240" MaxWidth="640" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar: connections -->
            <Grid x:Name="Sidebar" Margin="12,0,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <ui:Button Icon="{ui:SymbolIcon Add24}" Content="{l:L NewConnection}" Appearance="Primary" Click="NewConnection_Click"
                               ToolTip="{l:L NewConnectionTip}" Margin="0,0,6,0" />
                    <ui:Button Style="{StaticResource ToolbarButton}" Icon="{ui:SymbolIcon FolderAdd24}" Click="NewGroup_Click" ToolTip="{l:L NewGroup}" />
                    <ui:Button Style="{StaticResource ToolbarButton}" Icon="{ui:SymbolIcon Key24}" Click="Credentials_Click" ToolTip="{l:L Credentials}" />
                    <ui:Button x:Name="MoreButton" Style="{StaticResource ToolbarButton}" Icon="{ui:SymbolIcon MoreHorizontal24}" Click="More_Click" ToolTip="{l:L More}">
                        <ui:Button.ContextMenu>
                            <ContextMenu Closed="MoreMenu_Closed">
                                <MenuItem Header="{l:L Import}" Click="Import_Click" Icon="{ui:SymbolIcon ArrowImport24}" />
                                <MenuItem Header="{l:L Export}" Click="Export_Click" Icon="{ui:SymbolIcon ArrowExportLtr24}" />
                                <Separator />
                                <MenuItem Header="{l:L DisconnectAll}" Click="DisconnectAll_Click" Icon="{ui:SymbolIcon PlugDisconnected24}" />
                                <MenuItem Header="{l:L SignOutAll}" Click="SignOutAll_Click" Icon="{ui:SymbolIcon SignOut24}" />
                                <Separator />
                                <MenuItem Header="{l:L MachinesTitle}" Click="Machines_Click" Icon="{ui:SymbolIcon Cloud24}" InputGestureText="Ctrl+M" />
                                <MenuItem Header="{l:L Scripts}" Click="Scripts_Click" Icon="{ui:SymbolIcon Code24}" />
                            </ContextMenu>
                        </ui:Button.ContextMenu>
                    </ui:Button>
                </StackPanel>

                <!-- Favorites -->
                <StackPanel Grid.Row="1" x:Name="FavoritesPanel">
                    <!-- The header folds the list (remembered); its count stays in sight when folded -->
                    <Grid>
                        <ui:Button x:Name="FavoritesHeader" Appearance="Transparent" BorderThickness="0" Padding="0,0,6,0" Margin="0,10,0,0"
                                   HorizontalAlignment="Left" Click="FavoritesHeader_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="FavoritesHeaderText" Style="{StaticResource SectionHeader}" Margin="4,6,6,6" />
                                <!-- Turned a quarter to the side while folded -->
                                <ui:SymbolIcon x:Name="FavoritesChevron" Symbol="ChevronDown20" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" RenderTransformOrigin="0.5,0.5">
                                    <ui:SymbolIcon.RenderTransform>
                                        <RotateTransform x:Name="FavoritesChevronTurn" />
                                    </ui:SymbolIcon.RenderTransform>
                                </ui:SymbolIcon>
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Play20, FontSize=16}"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2"
                                   Click="ConnectAllFavorites_Click" ToolTip="{l:L FavoritesConnectAll}" />
                    </Grid>
                    <!-- What folds: a clip around the list, as the tree folds its groups. Animating the list itself made it
                         show its scroll bar while shrinking; in the StackPanel it keeps its own height and is only cut off. -->
                    <Border x:Name="FavoritesBody">
                        <StackPanel>
                            <!-- The same rows and menu as the tree; Delete takes a connection off the favorites, not out of the data.
                                 Dragged to reorder, or dragged in from the tree; with Ctrl held, the number of Ctrl+1…9 shows. -->
                            <ListBox x:Name="FavoritesList" Tag="Favorites" ItemsSource="{Binding Favorites}" MaxHeight="300" AlternationCount="1000"
                                     ScrollViewer.CanContentScroll="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AllowDrop="True"
                                     ContextMenu="{StaticResource NodeMenu}" AutomationProperties.Name="{l:L Favorites}"
                                     MouseDoubleClick="Favorites_MouseDoubleClick" KeyDown="Favorites_KeyDown"
                                     PreviewMouseRightButtonDown="Favorites_PreviewMouseRightButtonDown" GotKeyboardFocus="Favorites_GotKeyboardFocus"
                                     PreviewMouseLeftButtonDown="Favorites_PreviewMouseLeftButtonDown" PreviewMouseMove="Favorites_PreviewMouseMove"
                                     DragOver="Favorites_DragOver" DragLeave="Favorites_DragLeave" Drop="Favorites_Drop">
                                <!-- As low as the tree's rows: the same rows, the same rhythm -->
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="Padding" Value="12,3,5,3" /> <!-- right: the dots in one column with the tree's -->
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Spoken}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <ContentPresenter Content="{Binding}" />
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0" Padding="6,0,6,1" CornerRadius="4"
                                                    Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                    BorderThickness="1,1,1,2"
                                                    Visibility="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={x:Static l:FavoriteNumber.Shown}}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ShowFavoriteNumbers, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                                <Setter Property="Opacity" Value="0" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="11" Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={x:Static l:FavoriteNumber.Text}}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Tree / search results -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="TreeHeader" Text="{l:L Connections}" Style="{StaticResource SectionHeader}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2">
                        <StackPanel x:Name="ExpandButtons" Orientation="Horizontal">
                            <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon ChevronDoubleDown20, FontSize=16}"
                                       Click="ExpandAll_Click" ToolTip="{l:L ExpandAll}" />
                            <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon ChevronDoubleUp20, FontSize=16}"
                                       Click="CollapseAll_Click" ToolTip="{l:L CollapseAll}" />
                        </StackPanel>
                        <ui:Button x:Name="RefreshProbeButton" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon ArrowSync16}"
                                   Click="RefreshProbe_Click" ToolTip="{l:L RefreshAvailability}" />
                    </StackPanel>

                    <TreeView x:Name="Tree" Grid.Row="1" Background="Transparent" ScrollViewer.CanContentScroll="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemsSource="{Binding Store.Roots}" AllowDrop="True"
                              ContextMenu="{StaticResource NodeMenu}" AutomationProperties.Name="{l:L Connections}"
                              MouseDoubleClick="Tree_MouseDoubleClick" KeyDown="Tree_KeyDown" PreviewKeyDown="Tree_PreviewKeyDown"
                              PreviewMouseLeftButtonDown="Tree_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="Tree_PreviewMouseLeftButtonUp" PreviewMouseMove="Tree_PreviewMouseMove"
                              PreviewMouseRightButtonDown="Tree_PreviewMouseRightButtonDown" GotKeyboardFocus="List_GotKeyboardFocus"
                              DragOver="Tree_DragOver" DragLeave="Tree_DragLeave" Drop="Tree_Drop">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="{Binding Expanded, Mode=TwoWay}" />
                                <Setter Property="l:Motion.AnimateExpand" Value="True" />
                                <!-- Rows as wide as the tree: the status dots line up at the right edge, as in the other lists -->
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <!-- For a screen reader: the name with the state the row only shows as icons and the status dot -->
                                <Setter Property="AutomationProperties.Name" Value="{Binding Spoken}" />
                                <EventSetter Event="Loaded" Handler="TreeItem_Loaded" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>

                    <ListBox x:Name="Results" Grid.Row="1" Visibility="Collapsed" ScrollViewer.CanContentScroll="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemsSource="{Binding SearchResults}"
                             ContextMenu="{StaticResource NodeMenu}" AutomationProperties.Name="{l:L SearchResults}"
                             MouseDoubleClick="Results_MouseDoubleClick" KeyDown="Results_KeyDown" PreviewMouseRightButtonDown="Results_PreviewMouseRightButtonDown"
                             GotKeyboardFocus="List_GotKeyboardFocus">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Spoken}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <StackPanel x:Name="EmptyTree" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16">
                        <ui:SymbolIcon Symbol="Desktop32" FontSize="40" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{l:L NoConnections}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Grid>

            <GridSplitter x:Name="Splitter" Grid.Column="1" Width="12" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext" KeyboardIncrement="16" AutomationProperties.Name="{l:L SidebarWidth}"
                          DragCompleted="Splitter_DragCompleted" />

            <!-- Home: what the list on the left cannot show. Open sessions with their live pictures, and the sessions left
                 running on servers (they want a decision). Machines and recent connections are in the list, the machines
                 window and the search: repeated here, the same machine showed four or five times in one window. -->
            <Border Grid.Column="2" Margin="0,0,12,12" CornerRadius="8" ClipToBounds="True"
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- The InfoBar template shows Title and Message only: the action sits under it, closing with it -->
                    <StackPanel Margin="12,12,12,0">
                        <ui:InfoBar x:Name="UpdateBar" Severity="Informational" IsClosable="True" IsOpen="False" Title="{l:L UpdateAvailableTitle}" />
                        <ui:Button Content="{l:L UpdateRestart}" Appearance="Primary" Click="UpdateRestart_Click" HorizontalAlignment="Right" Margin="0,6,0,0"
                                   Visibility="{Binding IsOpen, ElementName=UpdateBar, Converter={StaticResource BoolToVis}}" />
                        <!-- After an update: that things changed, the list one click away. It was a window to close before anything
                             could be done; closing the bar (or reading the list) is what counts as seen. -->
                        <ui:InfoBar x:Name="NewsBar" Severity="Informational" IsClosable="True" IsOpen="False"
                                    Title="{l:L WhatsNewBarTitle}" Message="{l:L WhatsNewBarText}" />
                        <ui:Button Content="{l:L WhatsNew}" Click="NewsShow_Click" HorizontalAlignment="Right" Margin="0,6,0,0"
                                   Visibility="{Binding IsOpen, ElementName=NewsBar, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <!-- Wide enough for three session tiles in a row -->
                        <StackPanel x:Name="HomeContent" MaxWidth="1056" Margin="24,0,24,32" VerticalAlignment="Center">
                            <StackPanel x:Name="Welcome" Margin="0,32,0,0">
                                <ui:SymbolIcon Symbol="DesktopPulse24" FontSize="56" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock x:Name="WelcomeTitle" Style="{StaticResource TitleText}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,12,0,6" />
                                <TextBlock x:Name="WelcomeHint" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" MaxWidth="560"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <!-- First run: the two ways to get connections in -->
                            <StackPanel x:Name="FirstRun" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                                <ui:Button Content="{l:L AddFirstConnection}" Icon="{ui:SymbolIcon Add24}" Appearance="Primary" Click="NewConnection_Click" Margin="0,0,8,0" />
                                <ui:Button Content="{l:L ImportConnections}" Icon="{ui:SymbolIcon ArrowImport24}" Click="Import_Click" />
                            </StackPanel>

                            <!-- Sessions in their own windows, each with its live picture (as in the switcher). Centered as a
                                 block: the header stays lined up with the first tile. -->
                            <StackPanel x:Name="OpenSessionsPanel" HorizontalAlignment="Center">
                                <TextBlock Text="{l:L OpenSessions}" Style="{StaticResource SectionHeader}" Margin="4,32,4,8" />
                                <ItemsControl ItemsSource="{Binding Sessions.Open}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type l:RdpSession}">
                                            <Border Width="336" Margin="4" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                <StackPanel>
                                                    <ui:Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Appearance="Transparent"
                                                               BorderThickness="0" Padding="8,8,8,4" Click="OpenSession_Click" Tag="{Binding}" ToolTip="{l:L CardShowTip}" PreviewMouseLeftButtonDown="Card_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="Card_PreviewMouseLeftButtonUp"
                                                               AutomationProperties.Name="{Binding Title}">
                                                        <l:LiveThumbnail Session="{Binding}" Height="178" CornerRadius="4"
                                                                         Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}">
                                                            <TextBlock Text="{l:L SwitcherMinimized}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                        </l:LiveThumbnail>
                                                    </ui:Button>
                                                    <Grid Margin="0,0,6,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="3" Margin="0,2,9,2" CornerRadius="0,1.5,1.5,0"
                                                                Background="{Binding Connection.EffectiveColor, Converter={StaticResource HexBrush}}" />
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Ellipse Style="{StaticResource PhaseDot}" Margin="0,0,8,0" />
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding StatusLine}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <l:SignalBars Grid.Column="2" Level="{Binding Quality}" VerticalAlignment="Center" Margin="8,0,4,0"
                                                                      ToolTip="{Binding NetworkInfo}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon PictureInPicture24}"
                                                                       Click="OpenSessionMini_Click" Tag="{Binding}" ToolTip="{l:L MiniView}" />
                                                            <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon FullScreenMaximize24}"
                                                                       Click="OpenSessionFullScreen_Click" Tag="{Binding}" ToolTip="{l:L FullScreen}" />
                                                            <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Dismiss24}"
                                                                       Click="OpenSessionDisconnect_Click" Tag="{Binding}" ToolTip="{l:L Disconnect}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Sessions left running: disconnected, not signed out (see Connection.LeftRunningAt) -->
                            <StackPanel x:Name="LeftRunningPanel" HorizontalAlignment="Center">
                                <TextBlock x:Name="LeftRunningHeader" Style="{StaticResource SectionHeader}" Margin="4,32,4,8" />
                                <ItemsControl ItemsSource="{Binding LeftRunning}" Focusable="False" ItemTemplate="{StaticResource ConnectionCard}"
                                              ItemsPanel="{StaticResource CardPanel}" />
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
