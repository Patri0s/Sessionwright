<Window x:Class="Sessionwright.SessionSwitcher"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Sessionwright"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" SizeToContent="WidthAndHeight"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        Title="{l:L SwitcherTitle}" PreviewKeyDown="OnPreviewKeyDown" Deactivated="OnDeactivated">
    <!-- Opaque, like the full-screen bar: DWM draws the thumbnails into it and rounds its corners (see code-behind). -->
    <StackPanel x:Name="Root" Margin="20,16,20,18">
        <TextBlock Text="{l:L SwitcherTitle}" FontSize="16" FontWeight="SemiBold" />
        <TextBlock x:Name="Hint" Text="{l:L SwitcherHint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,12" />
        <!-- Side by side, at most three to a row -->
        <UniformGrid x:Name="Tiles" HorizontalAlignment="Left" />
    </StackPanel>
</Window>
