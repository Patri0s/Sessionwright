<Window x:Class="Sessionwright.Notification"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:l="clr-namespace:Sessionwright"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        Width="380" SizeToContent="Height" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}" Title="Sessionwright">
    <!-- Opaque, like the full-screen bar: rounded corners and shadow come from DWM (see code-behind). -->
    <Grid x:Name="Root" Margin="16,14,8,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ui:SymbolIcon x:Name="Glyph" FontSize="22" VerticalAlignment="Top" Margin="0,1,12,0"
                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
        <StackPanel Grid.Column="1">
            <TextBlock x:Name="TitleText" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <WrapPanel x:Name="Actions" Margin="0,12,0,0" />
        </StackPanel>
        <ui:Button Grid.Column="2" Style="{StaticResource IconButton}" Width="32" Height="32" VerticalAlignment="Top" Margin="4,-8,0,0"
                   Icon="{ui:SymbolIcon Dismiss16}" Click="Close_Click" ToolTip="{l:L CloseNotification}" />
    </Grid>
</Window>
