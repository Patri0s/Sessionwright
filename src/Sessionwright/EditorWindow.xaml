<ui:FluentWindow x:Class="Sessionwright.EditorWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:Sessionwright"
                 Width="580" Height="700" MinWidth="460" MinHeight="400"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <ui:FluentWindow.Resources>
        <!-- Environment color swatch: a radio button, so the palette works with Tab, arrows, Space and screen readers.
             Checked: an accent ring around the swatch; keyboard focus: a focus ring outside it. -->
        <!-- The last swatch: a dashed circle with a plus, opening the full color picker -->
        <Style x:Key="AddSwatch" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Fill" Width="22" Height="22" Stroke="{DynamicResource TextFillColorTertiaryBrush}"
                                     StrokeThickness="1.3" StrokeDashArray="2.2,1.6" />
                            <ui:SymbolIcon x:Name="Plus" Symbol="Add16" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Stroke" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Setter TargetName="Plus" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Fill" Property="Stroke" Value="{DynamicResource FocusStrokeColorOuterBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Swatch" TargetType="RadioButton">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <!-- Only for keyboard navigation (a trigger on IsKeyboardFocused also fired on a click): outside the ring -->
            <Setter Property="FocusVisualStyle">
                <Setter.Value>
                    <Style>
                        <Setter Property="Control.Template">
                            <Setter.Value>
                                <ControlTemplate>
                                    <Ellipse Margin="-2" Stroke="{DynamicResource FocusStrokeColorOuterBrush}" StrokeThickness="2" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <!-- Selected: an accent ring with a gap around the color, like the Windows color pickers -->
                            <Ellipse x:Name="Ring" Width="32" Height="32" Stroke="{DynamicResource AccentTextFillColorPrimaryBrush}" StrokeThickness="2" Visibility="Collapsed" />
                            <Ellipse x:Name="Fill" Width="22" Height="22" Fill="{TemplateBinding Background}" Stroke="{DynamicResource CardStrokeColorDefaultBrush}" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Stroke" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tabs like the Windows 11 Settings app: secondary text, the chosen one in full color with a short accent
             underline, a subtle background on hover; a thin divider under the row. -->
        <Style x:Key="Tabs" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TabPanel IsItemsHost="True" Margin="20,0,20,0" KeyboardNavigation.TabIndex="1" />
                            <Border Grid.Row="1" Height="1" Margin="24,0,24,0" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="2" ContentSource="SelectedContent" Margin="16,4,16,0" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Tab" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="14" />
            <!-- Keyboard focus: the rounded double ring of Windows 11 controls, not WPF's dotted rectangle -->
            <Setter Property="FocusVisualStyle">
                <Setter.Value>
                    <Style>
                        <Setter Property="Control.Template">
                            <Setter.Value>
                                <ControlTemplate>
                                    <Border Margin="0,2,4,5" CornerRadius="5" BorderThickness="2" BorderBrush="{DynamicResource FocusStrokeColorOuterBrush}" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Background="Transparent" Margin="0,0,4,0">
                            <Border x:Name="Hover" CornerRadius="4" Margin="0,4,0,7" Background="Transparent" />
                            <ContentPresenter ContentSource="Header" Margin="12,9,12,12" HorizontalAlignment="Center" />
                            <Border x:Name="Line" Height="3" Width="20" CornerRadius="1.5" VerticalAlignment="Bottom" Margin="0,0,0,1"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Hidden" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Line" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="Bar" ShowMinimize="False" ShowMaximize="False" />

        <!-- Three tabs instead of one long column: what it is, its Azure machine, how the session looks -->
        <TabControl FocusVisualStyle="{x:Null}" l:Motion.Entrance="True" x:Name="Tabs" Grid.Row="1" Style="{StaticResource Tabs}" ItemContainerStyle="{StaticResource Tab}">
            <TabItem Header="{l:L TabGeneral}">
                <ScrollViewer Padding="8,0,8,16" VerticalScrollBarVisibility="Auto">
                    <StackPanel TextBoxBase.TextChanged="Field_Changed" Selector.SelectionChanged="Field_Changed">
                        <StackPanel x:Name="ConnectionFields">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{l:L Host}" Style="{StaticResource FieldLabel}" />
                                    <ui:TextBox x:Name="HostBox" PlaceholderText="{l:L HostPlaceholder}" AutomationProperties.Name="{l:L Host}"
                                                TextChanged="HostBox_TextChanged" LostFocus="HostBox_LostFocus" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{l:L Port}" Style="{StaticResource FieldLabel}" />
                                    <ui:TextBox x:Name="PortBox" AutomationProperties.Name="{l:L Port}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <TextBlock Text="{l:L Name}" Style="{StaticResource FieldLabel}" />
                        <ui:TextBox x:Name="NameBox" AutomationProperties.Name="{l:L Name}" />

                        <TextBlock Text="{l:L Group}" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="ParentBox" AutomationProperties.Name="{l:L Group}" SelectionChanged="ParentBox_SelectionChanged" />

                        <TextBlock Text="{l:L EnvironmentColor}" Style="{StaticResource FieldLabel}" />
                        <!-- The small negative margin lines the first ring up with the fields above; nothing is clipped. -->
                        <WrapPanel x:Name="ColorPanel" Margin="-2,0,0,2" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        <TextBlock x:Name="ColorInherited" Style="{StaticResource Caption}" TextWrapping="Wrap" />

                        <TextBlock Text="{l:L Credential}" Style="{StaticResource FieldLabel}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CredentialBox" AutomationProperties.Name="{l:L Credential}" SelectionChanged="CredentialBox_SelectionChanged" />
                            <ui:Button Grid.Column="1" Margin="8,0,0,0" Icon="{ui:SymbolIcon Key24}" Click="ManageCredentials_Click"
                                       ToolTip="{l:L Credentials}" AutomationProperties.Name="{l:L Credentials}" />
                        </Grid>
                        <TextBlock x:Name="CredentialInherited" Style="{StaticResource Caption}" TextWrapping="Wrap" />

                        <StackPanel x:Name="TagsFields">
                            <TextBlock Text="{l:L Tags}" Style="{StaticResource FieldLabel}" />
                            <ui:TextBox x:Name="TagsBox" PlaceholderText="{l:L TagsPlaceholder}" AutomationProperties.Name="{l:L Tags}" />
                        </StackPanel>

                        <TextBlock Text="{l:L Notes}" Style="{StaticResource FieldLabel}" />
                        <ui:TextBox x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" AutomationProperties.Name="{l:L Notes}" />

                        <!-- Web addresses opened from it (on this PC or in its session); a group's for its connections too -->
                        <TextBlock Text="{l:L Links}" Style="{StaticResource FieldLabel}" />
                        <StackPanel x:Name="LinksPanel" />
                        <ui:Button x:Name="AddLinkButton" Content="{l:L LinkAdd}" Icon="{ui:SymbolIcon Add24}" Click="AddLink_Click" HorizontalAlignment="Left" />
                        <TextBlock x:Name="LinksHint" Text="{l:L LinksHint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock x:Name="LinksInherited" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{l:L TabAzure}">
                <ScrollViewer Padding="8,0,8,16" VerticalScrollBarVisibility="Auto">
                    <StackPanel TextBoxBase.TextChanged="Field_Changed" Selector.SelectionChanged="Field_Changed">
                        <TextBlock x:Name="AzureTabHint" Text="{l:L AzureTabGroupHint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0" />
                        <StackPanel x:Name="VmFields">
                            <TextBlock Text="{l:L AzureVm}" Style="{StaticResource FieldLabel}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="AzureVmText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="{l:L AzureVmChoose}" Icon="{ui:SymbolIcon Cloud24}" Click="ChooseVm_Click" />
                                <ui:Button x:Name="UnlinkVmButton" Grid.Column="2" Margin="8,0,0,0" Icon="{ui:SymbolIcon LinkDismiss24}" Click="UnlinkVm_Click"
                                           ToolTip="{l:L AzureVmUnlink}" AutomationProperties.Name="{l:L AzureVmUnlink}" />
                            </Grid>
                        </StackPanel>

                        <TextBlock Text="{l:L AutoStart}" Style="{StaticResource FieldLabel}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="AutoStartBox" SelectionChanged="AutoStartBox_SelectionChanged" AutomationProperties.Name="{l:L AutoStart}" />
                            <ui:TextBox x:Name="AutoStartTimeBox" Grid.Column="1" Width="96" Margin="8,0,0,0" PlaceholderText="08:00"
                                        ToolTip="{l:L AutoStartTime}" AutomationProperties.Name="{l:L AutoStartTime}" />
                        </Grid>
                        <TextBlock x:Name="AutoStartInherited" Style="{StaticResource Caption}" TextWrapping="Wrap" />

                        <TextBlock Text="{l:L ShutDownAfterSetting}" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="ShutDownAfterBox" SelectionChanged="AutoStartBox_SelectionChanged" AutomationProperties.Name="{l:L ShutDownAfterSetting}" />
                        <TextBlock x:Name="ShutDownAfterInherited" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{l:L TabRdp}">
                <ScrollViewer Padding="8,0,8,16" VerticalScrollBarVisibility="Auto">
                    <StackPanel TextBoxBase.TextChanged="Field_Changed" Selector.SelectionChanged="Field_Changed">
                        <CheckBox x:Name="InheritBox" Content="{l:L InheritRdp}" Checked="InheritBox_Changed" Unchecked="InheritBox_Changed" Margin="0,12,0,0" />
                        <TextBlock x:Name="RdpInherited" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="28,0,0,0" />
                        <l:RdpOptionsView x:Name="Options" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Padding="24,12" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button Content="{l:L Save}" Appearance="Primary" IsDefault="True" Click="Save_Click" MinWidth="100" Margin="0,0,8,0" />
                    <ui:Button Content="{l:L Cancel}" IsCancel="True" MinWidth="100" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
