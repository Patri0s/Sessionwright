<ui:FluentWindow x:Class="Sessionwright.PasswordPrompt"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:Sessionwright"
                 Title="Sessionwright" Width="460" MinHeight="0" SizeToContent="Height" ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel>
        <ui:TitleBar ShowMinimize="False" ShowMaximize="False" />

        <Grid Margin="24,4,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:SymbolIcon Symbol="LockClosed24" Filled="True" FontSize="32" Margin="0,0,16,0" VerticalAlignment="Top"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="MessageText" FontSize="14" TextWrapping="Wrap" />
                <TextBlock Text="{l:L ExportPassword}" Style="{StaticResource FieldLabel}" />
                <ui:PasswordBox x:Name="PasswordBox" AutomationProperties.Name="{l:L ExportPassword}" />
                <StackPanel x:Name="ConfirmPanel">
                    <TextBlock Text="{l:L ExportPasswordRepeat}" Style="{StaticResource FieldLabel}" />
                    <ui:PasswordBox x:Name="ConfirmBox" AutomationProperties.Name="{l:L ExportPasswordRepeat}" />
                </StackPanel>
                <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <Border Padding="24,12" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="PrimaryButton" Appearance="Primary" IsDefault="True" MinWidth="100" Click="Primary_Click" />
                <ui:Button x:Name="SecondaryButton" IsCancel="True" MinWidth="100" Margin="8,0,0,0" />
            </StackPanel>
        </Border>
    </StackPanel>
</ui:FluentWindow>
