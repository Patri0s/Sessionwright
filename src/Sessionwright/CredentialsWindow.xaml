<ui:FluentWindow x:Class="Sessionwright.CredentialsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:Sessionwright"
                 Width="760" Height="520" MinWidth="600" MinHeight="400"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar x:Name="Bar" ShowMinimize="False" ShowMaximize="False" />

        <Grid l:Motion.Entrance="True" Grid.Row="1" Margin="24,0,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <ui:Button Content="{l:L Add}" Icon="{ui:SymbolIcon Add24}" Appearance="Primary" Click="Add_Click" Margin="0,0,8,0" />
                    <ui:Button x:Name="DeleteButton" Content="{l:L Delete}" Icon="{ui:SymbolIcon Delete24}" Click="Delete_Click" />
                </StackPanel>
                <Grid>
                    <ListBox x:Name="List" ScrollViewer.CanContentScroll="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemsSource="{Binding Credentials}"
                             SelectionChanged="List_SelectionChanged" AutomationProperties.Name="{l:L Credentials}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="Key24" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding FullUser}" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel x:Name="EmptyState" Margin="16" VerticalAlignment="Center" Visibility="Collapsed">
                        <ui:SymbolIcon Symbol="Key24" FontSize="40" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{l:L NoCredentials}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0" />
                        <TextBlock Text="{l:L NoCredentialsHint}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,12" />
                        <ui:Button Content="{l:L Add}" Icon="{ui:SymbolIcon Add24}" Click="Add_Click" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </DockPanel>

            <StackPanel x:Name="Form" Grid.Column="2" DataContext="{Binding SelectedItem, ElementName=List}">
                <TextBlock Text="{l:L Name}" Style="{StaticResource FieldLabel}" />
                <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:L Name}" />
                <TextBlock Text="{l:L User}" Style="{StaticResource FieldLabel}" />
                <ui:TextBox Text="{Binding User, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{l:L UserPlaceholder}" AutomationProperties.Name="{l:L User}" />
                <TextBlock Text="{l:L Domain}" Style="{StaticResource FieldLabel}" />
                <ui:TextBox Text="{Binding Domain, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{l:L Optional}" AutomationProperties.Name="{l:L Domain}" />
                <TextBlock Text="{l:L Password}" Style="{StaticResource FieldLabel}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:PasswordBox x:Name="PasswordBox" AutomationProperties.Name="{l:L Password}" />
                    <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="{l:L SetPassword}" Click="SetPassword_Click" />
                </Grid>
                <TextBlock x:Name="PasswordState" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="UsageText" Style="{StaticResource Caption}" Margin="0,16,0,0" TextWrapping="Wrap" />
                <TextBlock Text="{l:L DpapiNote}" Style="{StaticResource Caption}" Margin="0,16,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <!-- Edits apply as they are typed (committed on close): Esc or Close is all that is needed, no Save/Cancel.
             Not IsDefault: Enter in a field would close the window mid-edit. -->
        <Border Grid.Row="2" Padding="24,12" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <ui:Button Content="{l:L CloseWindow}" IsCancel="True" MinWidth="100" HorizontalAlignment="Right" />
        </Border>
    </Grid>
</ui:FluentWindow>
