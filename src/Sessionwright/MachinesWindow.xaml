<ui:FluentWindow x:Class="Sessionwright.MachinesWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:Sessionwright"
                 Title="Sessionwright" Width="900" Height="660" MinWidth="600" MinHeight="400"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowStartupLocation="CenterScreen"
                 PreviewKeyDown="OnPreviewKeyDown">
    <ui:FluentWindow.Resources>
        <Style x:Key="Action" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="10,5" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar x:Name="Bar" />

        <!-- Search and filters -->
        <Grid x:Name="Filters" Grid.Row="1" Margin="24,4,24,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox x:Name="SearchBox" PlaceholderText="{l:L MachinesSearch}" Icon="{ui:SymbolIcon Search24}"
                        TextChanged="Filter_Changed" AutomationProperties.Name="{l:L MachinesSearch}" />
            <CheckBox x:Name="RunningOnlyBox" Grid.Column="1" Content="{l:L MachinesRunningOnly}" Margin="16,0,0,0"
                      Checked="Filter_Changed" Unchecked="Filter_Changed" />
            <CheckBox x:Name="ShowHiddenBox" Grid.Column="2" Content="{l:L MachinesShowHidden}" Margin="12,0,0,0"
                      Checked="Filter_Changed" Unchecked="Filter_Changed" />
            <ui:Button x:Name="RefreshButton" Grid.Column="3" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon ArrowSync24}"
                       Margin="8,0,0,0" Click="Refresh_Click" ToolTip="{l:L MachinesRefresh}" />
        </Grid>

        <!-- What can be done to the selected machines -->
        <WrapPanel x:Name="Actions" Grid.Row="2" Margin="24,0,24,4">
            <ui:Button x:Name="StartButton" Style="{StaticResource Action}" Content="{l:L MachinesStart}" Icon="{ui:SymbolIcon Play24}" Click="Start_Click" />
            <ui:Button x:Name="StopButton" Style="{StaticResource Action}" Content="{l:L MachinesStop}" Icon="{ui:SymbolIcon Power24}" Click="Stop_Click" />
            <ui:Button x:Name="RestartButton" Style="{StaticResource Action}" Content="{l:L MachinesRestart}" Icon="{ui:SymbolIcon ArrowReset24}" Click="Restart_Click" />
            <ui:Button x:Name="PostponeButton" Style="{StaticResource Action}" Content="{l:L MachinesPostpone}" Icon="{ui:SymbolIcon Clock24}" Click="Postpone_Click" />
            <ui:Button x:Name="ConnectButton" Style="{StaticResource Action}" Content="{l:L MachinesConnect}" Icon="{ui:SymbolIcon PlugConnected24}" Click="Connect_Click" />
            <ui:Button x:Name="CreateButton" Style="{StaticResource Action}" Content="{l:L MachinesCreate}" Icon="{ui:SymbolIcon Add24}" Click="Create_Click" />
            <ui:Button x:Name="HideButton" Style="{StaticResource Action}" Content="{l:L MachinesHide}" Icon="{ui:SymbolIcon EyeOff24}" Click="Hide_Click" />
        </WrapPanel>

        <Grid l:Motion.Entrance="True" Grid.Row="3" Margin="24,0,24,12">
            <ListBox x:Name="List" SelectionMode="Extended" ScrollViewer.CanContentScroll="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="List_SelectionChanged" MouseDoubleClick="List_MouseDoubleClick" AutomationProperties.Name="{l:L MachinesTitle}"
                     PreviewMouseRightButtonDown="List_PreviewMouseRightButtonDown">
                <!-- The same actions as the bar above, as in the connection tree; only those that fit the selection -->
                <ListBox.ContextMenu>
                    <ContextMenu Opened="Menu_Opened">
                        <MenuItem x:Name="ConnectItem" Header="{l:L MachinesConnect}" Click="Connect_Click" Icon="{ui:SymbolIcon PlugConnected24}" FontWeight="SemiBold" InputGestureText="Enter" />
                        <MenuItem x:Name="StartItem" Header="{l:L MachinesStart}" Click="Start_Click" Icon="{ui:SymbolIcon Play24}" />
                        <MenuItem x:Name="StopItem" Header="{l:L MachinesStop}" Click="Stop_Click" Icon="{ui:SymbolIcon Power24}" />
                        <MenuItem x:Name="RestartItem" Header="{l:L MachinesRestart}" Click="Restart_Click" Icon="{ui:SymbolIcon ArrowReset24}" />
                        <MenuItem x:Name="PostponeItem" Header="{l:L MachinesPostpone}" Click="Postpone_Click" Icon="{ui:SymbolIcon Clock24}" />
                        <Separator />
                        <MenuItem x:Name="CreateItem" Header="{l:L MachinesCreate}" Click="Create_Click" Icon="{ui:SymbolIcon Add24}" />
                        <MenuItem x:Name="HideItem" Click="Hide_Click" Icon="{ui:SymbolIcon EyeOff24}" />
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource SectionHeader}" Margin="8,12,0,4" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type l:MachineRow}">
                        <Grid Margin="0,3" Opacity="{Binding Opacity}" AutomationProperties.Name="{Binding Name}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Style="{StaticResource OnlineDot}" DataContext="{Binding Row}" Margin="0,0,10,0" />
                            <ui:SymbolIcon Grid.Column="1" Symbol="Cloud24" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Row.VmStatusLine, Mode=OneWay}" /> · <Run Text="{Binding Details, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <!-- The connections that lead to it -->
                            <Border Grid.Column="3" Visibility="{Binding LinkedVisibility}" VerticalAlignment="Center" Margin="12,0,4,0" Padding="8,2"
                                    CornerRadius="4" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Desktop20" FontSize="12" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding Linked}" FontSize="12" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <!-- Loading, empty, or no account yet -->
            <l:StatusView x:Name="StatusPanel">
                <ui:Button x:Name="AddAccountButton" Content="{l:L AzureAddAccount}" Icon="{ui:SymbolIcon PersonAdd24}" Appearance="Primary"
                           HorizontalAlignment="Center" Margin="0,12,0,0" Visibility="Collapsed" Click="AddAccount_Click" />
            </l:StatusView>
        </Grid>

        <!-- Directories (e.g. where the account is a guest) that need their own sign-in before their VMs show up -->
        <ItemsControl x:Name="SignInList" Grid.Row="4" Margin="24,0,24,12" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="LockClosed24" Margin="0,0,10,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <ui:Button Grid.Column="2" Margin="12,0,0,0" Content="{l:L AzureSignInAgain}" Icon="{ui:SymbolIcon Person24}"
                                       Click="TenantSignIn_Click" Tag="{Binding}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Row="5" Padding="24,10" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- The list shown is the last one while a fresh one loads -->
                <ui:ProgressRing x:Name="RefreshRing" IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0" Visibility="Collapsed"
                                 ToolTip="{l:L AzureVmRefreshing}" />
                <TextBlock x:Name="CountText" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                <TextBlock x:Name="ProblemsText" Style="{StaticResource Caption}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="16,0,0,0"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
