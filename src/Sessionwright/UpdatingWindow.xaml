<ui:FluentWindow x:Class="Sessionwright.UpdatingWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:Sessionwright"
                 Title="Sessionwright" Width="400" MinWidth="0" MinHeight="0" SizeToContent="Height" ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
                 WindowStartupLocation="CenterScreen" ShowInTaskbar="True" Topmost="True">
    <!-- No title bar and no buttons: there is nothing to cancel, the app is closing to update itself -->
    <StackPanel Margin="32,32,32,28">
        <Image Source="pack://application:,,,/Sessionwright;component/Assets/logo.png" Width="56" Height="56" HorizontalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality" />
        <TextBlock Text="{l:L UpdatingTitle}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,6" />
        <TextBlock x:Name="VersionText" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <TextBlock Text="{l:L UpdatingRestart}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <ProgressBar IsIndeterminate="True" Margin="0,20,0,0" />
    </StackPanel>
</ui:FluentWindow>
