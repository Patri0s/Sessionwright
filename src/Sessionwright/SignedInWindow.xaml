<ui:FluentWindow x:Class="Sessionwright.SignedInWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:Sessionwright"
                 Title="Sessionwright" Width="560" Height="460" MinWidth="440" MinHeight="320"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar x:Name="Bar" ShowMinimize="False" ShowMaximize="False" />

        <!-- How the server is asked, and the other way when there is one -->
        <StackPanel Grid.Row="1" Margin="24,0,24,8">
            <TextBlock x:Name="RouteText" Style="{StaticResource Caption}" TextWrapping="Wrap" />
            <ui:HyperlinkButton x:Name="OtherRouteButton" Padding="0" Margin="0,2,0,0" Click="OtherRoute_Click" Visibility="Collapsed" />
            <!-- The list shown is the last one while a fresh one loads -->
            <StackPanel x:Name="AgePanel" Orientation="Horizontal" Margin="0,6,0,0" Visibility="Collapsed">
                <ui:ProgressRing IsIndeterminate="True" Width="14" Height="14" Margin="0,0,8,0" />
                <TextBlock x:Name="AgeText" Style="{StaticResource Caption}" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <Grid l:Motion.Entrance="True" Grid.Row="2" Margin="24,0,24,12">
            <ListBox x:Name="List" ScrollViewer.CanContentScroll="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="List_SelectionChanged" AutomationProperties.Name="{l:L SignedInUsers}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Person24" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Account}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Details}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <l:StatusView x:Name="StatusPanel"></l:StatusView>
        </Grid>

        <Border Grid.Row="3" Padding="24,12" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:Button x:Name="RefreshButton" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon ArrowClockwise24}" Click="Refresh_Click"
                           ToolTip="{l:L Refresh}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ui:Button x:Name="DisconnectButton" Content="{l:L DisconnectSession}" Icon="{ui:SymbolIcon PlugDisconnected24}" IsEnabled="False"
                               Click="Disconnect_Click" Margin="0,0,8,0" />
                    <ui:Button x:Name="SignOutButton" Content="{l:L SignOutUser}" Icon="{ui:SymbolIcon SignOut24}" IsEnabled="False"
                               Click="SignOut_Click" Margin="0,0,8,0" />
                    <ui:Button Content="{l:L Close}" IsCancel="True" MinWidth="90" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
