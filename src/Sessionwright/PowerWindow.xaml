<ui:FluentWindow x:Class="Sessionwright.PowerWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:Sessionwright"
                 Title="Sessionwright" Width="520" SizeToContent="Height" ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel>
        <ui:TitleBar x:Name="Bar" ShowMinimize="False" ShowMaximize="False" />
        <StackPanel l:Motion.Entrance="True" Margin="24,0,24,16">
            <!-- What is restarted / shut down and how each one is reached -->
            <TextBlock x:Name="TargetsText" TextWrapping="Wrap" FontWeight="SemiBold" />
            <TextBlock x:Name="RoutesText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
            <!-- Someone else on these machines (signed in, or started one lately): asked while the window is open -->
            <Border x:Name="SharedPanel" Margin="0,12,0,0" Padding="10,8" CornerRadius="6" BorderThickness="1"
                    Background="{DynamicResource SystemFillColorCautionBackgroundBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <StackPanel Orientation="Horizontal">
                    <ui:ProgressRing x:Name="SharedRing" IsIndeterminate="True" Width="14" Height="14" Margin="0,2,8,0" VerticalAlignment="Top" />
                    <ui:SymbolIcon x:Name="SharedIcon" Symbol="People24" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Top" Visibility="Collapsed"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                    <TextBlock x:Name="SharedText" Text="{l:L SharedChecking}" TextWrapping="Wrap" MaxWidth="420" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <RadioButton x:Name="RestartBox" Content="{l:L PowerRestart}" GroupName="Action" IsChecked="True" Checked="Changed" />
                <RadioButton x:Name="ShutdownBox" Content="{l:L PowerShutdown}" GroupName="Action" Margin="16,0,0,0" Checked="Changed" />
            </StackPanel>

            <TextBlock Text="{l:L PowerWhen}" Margin="0,16,0,6" />
            <ComboBox x:Name="DelayBox" Width="200" HorizontalAlignment="Left" SelectionChanged="Changed" AutomationProperties.Name="{l:L PowerWhen}" />

            <TextBlock Text="{l:L PowerMessage}" Margin="0,16,0,6" />
            <ui:TextBox x:Name="MessageText" TextWrapping="Wrap" AcceptsReturn="False" MinHeight="56" TextChanged="MessageBox_TextChanged"
                        AutomationProperties.Name="{l:L PowerMessage}" />
            <TextBlock Text="{l:L PowerMessageHint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />

            <CheckBox x:Name="ForceBox" Content="{l:L PowerForce}" IsChecked="True" Margin="0,12,0,0" />
        </StackPanel>
        <Border Padding="24,12" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="GoButton" Appearance="Danger" MinWidth="120" Click="Go_Click" />
                <ui:Button Content="{l:L Cancel}" IsCancel="True" MinWidth="100" Margin="8,0,0,0" />
            </StackPanel>
        </Border>
    </StackPanel>
</ui:FluentWindow>
