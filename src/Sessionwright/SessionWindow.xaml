<ui:FluentWindow x:Class="Sessionwright.SessionWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:Sessionwright"
                 Title="{Binding WindowTitle}" Icon="pack://application:,,,/Sessionwright;component/Assets/app.ico" Width="1280" Height="800" MinWidth="480" MinHeight="360"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
                 WindowStartupLocation="Manual" PreviewKeyDown="OnPreviewKeyDown" Closing="OnClosing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="Bar" Title="{Binding WindowTitle}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Sessionwright;component/Assets/app.ico" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                    <!-- The Azure VM behind it: state, auto-shutdown (postpone / skip), shut down after disconnecting -->
                    <ui:Button x:Name="VmButton" Appearance="Transparent" BorderThickness="0" Height="32" Padding="8,0" Margin="0,0,6,0"
                               Click="Shutdown_Click" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon x:Name="VmIcon" Symbol="Cloud20" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="VmText" Margin="5,0,0,0" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>
                    <!-- Connection quality: only while it is poor (it is in the "more" menu otherwise). A fine link needs no mark. -->
                    <l:SignalBars Level="{Binding Quality}" VerticalAlignment="Center" Margin="0,0,10,0"
                                  ToolTip="{Binding NetworkInfo}" Foreground="{DynamicResource SystemFillColorCautionBrush}">
                        <l:SignalBars.Style>
                            <Style TargetType="l:SignalBars">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Quality}" Value="1">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Quality}" Value="2">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </l:SignalBars.Style>
                    </l:SignalBars>
                    <!-- Two actions in sight: the one that ends the work, and the one used most. The rest (small view, reconnect,
                         Ctrl+Alt+Del, links) is one click away under "more", with its name next to the icon. -->
                    <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon SignOut24}" Click="SignOut_Click" ToolTip="{l:L SignOut}" IsEnabled="{Binding IsReady}" />
                    <ui:Button Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon FullScreenMaximize24}" Click="FullScreen_Click" ToolTip="{l:L FullScreenTip}" />
                    <ui:Button x:Name="MoreButton" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon MoreHorizontal24}" Click="More_Click" ToolTip="{l:L More}" />
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>
        <!-- Environment color of the connection (or its group) -->
        <Border x:Name="EnvStrip" Height="2" VerticalAlignment="Top" IsHitTestVisible="False"
                Background="{Binding Connection.EffectiveColor, Converter={StaticResource HexBrush}}" />

        <!-- The stage: the remote desktop, or the status screen while it is hidden. In the app's theme, like the covers. -->
        <Grid x:Name="Stage" Grid.Row="1" Background="{DynamicResource StageBrush}">
            <ContentPresenter x:Name="HostPresenter" Content="{Binding Host}" />

            <StackPanel x:Name="Status" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560" Margin="{Binding StatusMargin}"
                        TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowsDesktop}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Grid Width="56" Height="56" HorizontalAlignment="Center">
                    <ui:ProgressRing IsIndeterminate="True" Width="48" Height="48">
                        <ui:ProgressRing.Style>
                            <Style TargetType="ui:ProgressRing" BasedOn="{StaticResource {x:Type ui:ProgressRing}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Phase}" Value="Disconnected">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:ProgressRing.Style>
                    </ui:ProgressRing>
                    <ui:SymbolIcon FontSize="48" Filled="True">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Symbol" Value="PlugDisconnected24" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Phase}" Value="Disconnected">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter Property="Symbol" Value="ErrorCircle24" />
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                </Grid>
                <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,16,0,4" />
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <!-- What Windows says about a failed connection: under Sessionwright's own line, smaller -->
                <TextBlock Text="{Binding Details}" TextWrapping="Wrap" TextAlignment="Center" FontSize="12" Margin="0,10,0,0"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Details}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- Logon is taking long: maybe the server waits for input (logon banner, its own sign-in screen) -->
                <ui:HyperlinkButton Content="{l:L ShowRemoteScreen}" Command="{Binding ShowRemoteScreenCommand}" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <ui:HyperlinkButton.Style>
                        <Style TargetType="ui:HyperlinkButton" BasedOn="{StaticResource {x:Type ui:HyperlinkButton}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanShowRemoteScreen}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:HyperlinkButton.Style>
                </ui:HyperlinkButton>
                <WrapPanel HorizontalAlignment="Center" Margin="0,20,0,0">
                    <WrapPanel.Style>
                        <Style TargetType="WrapPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Phase}" Value="Disconnected">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </WrapPanel.Style>
                    <ui:Button Content="{l:L Reconnect}" Icon="{ui:SymbolIcon ArrowClockwise24}"
                               Command="{Binding ReconnectCommand}" Margin="4" />
                    <ui:Button Content="{l:L ConnectAs}" Icon="{ui:SymbolIcon Person24}" Command="{Binding ConnectAsCommand}" Margin="4" />
                    <ui:Button Content="{l:L CloseWindow}" Icon="{ui:SymbolIcon Dismiss24}" Click="CloseWindow_Click" Margin="4" />
                </WrapPanel>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
