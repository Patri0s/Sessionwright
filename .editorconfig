# Formatting only: what the files already follow. No analyzer rules, so it changes nothing about the build.
root = true

[*]
indent_style = space
indent_size = 4
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,yaml,json,slnx,csproj,manifest}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# The code keeps short object initializers on one line: the formatter must not break them up.
csharp_new_line_before_members_in_object_initializers = false
csharp_new_line_before_members_in_anonymous_types = false
